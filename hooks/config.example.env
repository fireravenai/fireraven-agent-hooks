# Copy to config.env and fill in your values:
#   cp config.example.env config.env && chmod 600 config.env

# Required: FireGuard API key (Project Settings -> API in the Fireraven app)
FIRERAVEN_GUARDRAILS_API_KEY=

# Required: FireGuard project ID (Project Settings -> General)
FIRERAVEN_PROJECT_ID=

# Optional: API base URL (default: https://api.fireraven.ai)
# FIRERAVEN_API_URL=https://api.fireraven.ai

# Optional: Guardrail execution mode passed to FireGuard on each check.
#   fast   - lower latency; runs eligible checks in parallel
#   normal - full sequential checks with complete policy/security details (default)
FIRERAVEN_EXECUTION_MODE=normal

# Optional: HTTP request timeout in seconds (default: 15)
# FIRERAVEN_REQUEST_TIMEOUT_SEC=15

# Optional: Hook behavior when FireGuard cannot run (missing config, no credits,
# network, timeout, HTTP error).
#   closed - block the agent action (recommended for strict enforcement)
#   open   - allow the action through and show a once-per-session notice (default)
# Policy violations and local sensitive-path blocks still deny regardless of this setting.
FIRERAVEN_FAIL_MODE=open

# Optional: disable automatic update checks (0/false/off)
# FIRERAVEN_UPDATE_CHECK=0

# Optional: override update check interval in seconds
# GitHub default 21600 (6h); GitLab raw_base default 300 (5m)
# FIRERAVEN_UPDATE_CHECK_INTERVAL_SEC=300

# Optional: GitLab PRIVATE-TOKEN for private-repo update checks (never commit real tokens)
# FIRERAVEN_HOOKS_TOKEN=
